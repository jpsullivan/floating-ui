{
  "extends": "config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc",
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src"],
  "references": [
    {"path": "../dom/tsconfig.lib.json"},
    {"path": "../utils/tsconfig.lib.json"}
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
